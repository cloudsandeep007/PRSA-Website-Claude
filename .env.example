# Copy this file to .env and fill in real values. Never commit .env.

# Supabase project
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres connection string — use the Session Pooler (port 5432)
# from Project Settings > Database > Connection Pooling if the direct
# connection host doesn't resolve on your network (IPv6-only).
DATABASE_URL=postgresql://postgres.your-project-ref:your-url-encoded-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Required — the server refuses to start without this. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=5000

# Comma-separated list of origins allowed to call the API cross-origin
# (the SPA's own origin is always allowed automatically). Needed for local
# dev when the Vite dev server (5173) calls the API server (5000).
CORS_ORIGIN=http://localhost:5173

# Used only the first time each admin account is created (the users table
# is checked first — an existing account is left alone). Quote values that
# contain #, since unquoted # starts a comment in .env files.
SEED_SUPER_ADMIN_PASSWORD=
SEED_CLIENT_ADMIN_PASSWORD=

# Public bucket base URL for hardcoded fallback/placeholder images (exposed
# to the frontend build via Vite's VITE_ prefix — not a secret).
VITE_MEDIA_BASE_URL=https://your-project-ref.supabase.co/storage/v1/object/public/media
